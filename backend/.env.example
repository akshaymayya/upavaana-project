# Copy to .env in backend/ (or the process working directory).
# The API loads the first existing .env into system properties at startup
# unless the same key is already set in the OS environment.

NVIDIA_API_KEY=
NVIDIA_BASE_URL=https://integrate.api.nvidia.com/v1

# deepseek = NVIDIA-hosted DeepSeek (uses NVIDIA_API_KEY, not DEEPSEEK_API_KEY)
# groq    = Groq (GROQ_API_KEY)
# openai  = gpt-4o when billing is approved
ACTIVE_SYNTHESIS_PROVIDER=deepseek

# Optional. NVIDIA NIM DeepSeek model when provider=deepseek.
# DEEPSEEK_NIM_MODEL=deepseek-ai/deepseek-v4-pro-0813

# Optional. Used only when ACTIVE_SYNTHESIS_PROVIDER=groq.
GROQ_API_KEY=
# GROQ_MODEL=openai/gpt-oss-120b

# Unused: official DeepSeek and OpenRouter are not called.
# DEEPSEEK_API_KEY=
# DEEPSEEK_BASE_URL=
# DEEPSEEK_MODEL=

# Used only when ACTIVE_SYNTHESIS_PROVIDER=openai.
OPENAI_API_KEY=
