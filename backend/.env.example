# Copy to .env in backend/ (or the process working directory).
# The API loads the first existing .env into system properties at startup.
# File values win so rotating GEMINI_API_KEY / GROQ_API_KEY in this file takes effect after restart.

# --- Vision (MVP live path: Gemini) ---
GEMINI_API_KEY=
# GEMINI_BASE_URL=https://generativelanguage.googleapis.com/v1beta
# GEMINI_VISION_MODEL=gemini-2.5-flash
# gemini = Gemini 2.5 Flash (MVP default). nvidia = legacy NVIDIA NIM vision (retained).
ACTIVE_VISION_PROVIDER=gemini

# --- Legacy NVIDIA (retained; not required when ACTIVE_VISION_PROVIDER=gemini) ---
NVIDIA_API_KEY=
NVIDIA_BASE_URL=https://integrate.api.nvidia.com/v1

# --- Synthesis (live path is Groq only; NVIDIA/DeepSeek text are not called) ---
ACTIVE_SYNTHESIS_PROVIDER=groq

# Optional. NVIDIA NIM DeepSeek model retained but unused on the live path.
# DEEPSEEK_NIM_MODEL=deepseek-ai/deepseek-v4-pro-0813

GROQ_API_KEY=
# GROQ_MODEL=openai/gpt-oss-120b

# Unused: official DeepSeek and OpenRouter are not called.
# DEEPSEEK_API_KEY=
# DEEPSEEK_BASE_URL=
# DEEPSEEK_MODEL=

# Used only when ACTIVE_SYNTHESIS_PROVIDER=openai.
OPENAI_API_KEY=
